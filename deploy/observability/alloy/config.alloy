// The collector. Two jobs:
//  - logs: tail the stdout of every container of this deployment (through the
//    Docker socket, read-only) and ship them to Loki, labelled by service and
//    level;
//  - traces: receive OTLP from the services and forward it to Tempo.
// Metrics do not pass through here: Prometheus scrapes the services itself.

// ------------------------------------------------------------------ logs

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Only this deployment's containers.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = sys.env("COMPOSE_PROJECT")
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  labels        = {environment = sys.env("COMMERCE_ENV")}
  forward_to    = [loki.process.levels.receiver]
}

// The services log ECS JSON: lift the level into a label (few values, cheap to
// index); everything else stays in the line and is parsed at query time.
loki.process "levels" {
  stage.json {
    expressions = {level = "log.level"}
  }
  stage.labels {
    values = {level = ""}
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---------------------------------------------------------------- traces

otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

    {
      "type": "logs",
      "title": "ERROR lines, every service",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{environment=~\".+\", level=\"ERROR\"}"

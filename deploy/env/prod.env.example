# PROD settings. Copy to deploy/env/prod.env (git-ignored), fill in every value,
# and keep the real file in your secret store. scripts/stack.sh prod refuses to
# start while any required value is empty. Generate secrets with:
#   openssl rand -base64 32        (JWT_SECRET, DATA_ENCRYPTION_KEY)
#   openssl rand -hex 24           (passwords; Kafka passwords: A-Z a-z 0-9 _ . - only)

# Where customers reach the shop (https, behind your TLS terminator).
APP_BASE_URL=
STOREFRONT_PORT=8081
OPS_CONSOLE_PORT=8082
PASSKEY_EXTRA_ORIGINS=
GRAFANA_PORT=3000
GRAFANA_PUBLIC_URL=
GRAFANA_ADMIN_PASSWORD=
# Alertmanager file with your people receivers (pager, chat), outside the repo.
# Default: deploy/observability/alertmanager/alertmanager.yml (the ops service only).
ALERTMANAGER_CONFIG=

# The first account verified with this address becomes an administrator.
BOOTSTRAP_ADMIN_EMAIL=

# The real payment provider and carrier.
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_KEY=
CARRIER_URL=
CARRIER_KEY=

# Outgoing mail.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=
SIGNUP_CHECK_MX=true

# Identity
JWT_SECRET=
DATA_ENCRYPTION_KEY=

# Shared by the edges and the services (X-Edge-Token): 32+ of A-Z a-z 0-9 _ . -
EDGE_SHARED_SECRET=

# MySQL: the administrator, and an owner and an app login per database
DB_ADMIN_PASSWORD=
DB_EXPORTER_PASSWORD=
IDENTITY_DB_OWNER_PASSWORD=
IDENTITY_DB_PASSWORD=
CATALOG_DB_OWNER_PASSWORD=
CATALOG_DB_PASSWORD=
ORDERS_DB_OWNER_PASSWORD=
ORDERS_DB_PASSWORD=
INVENTORY_DB_OWNER_PASSWORD=
INVENTORY_DB_PASSWORD=
BILLING_DB_OWNER_PASSWORD=
BILLING_DB_PASSWORD=
SHIPPING_DB_OWNER_PASSWORD=
SHIPPING_DB_PASSWORD=
NOTIFICATION_DB_OWNER_PASSWORD=
NOTIFICATION_DB_PASSWORD=
OPS_DB_OWNER_PASSWORD=
OPS_DB_PASSWORD=

# Kafka: one credential per principal (12+ of A-Z a-z 0-9 _ . -)
KAFKA_CLUSTER_ID=
KAFKA_PASSWORD_BROKER=
KAFKA_PASSWORD_INIT=
KAFKA_PASSWORD_CATALOG=
KAFKA_PASSWORD_ORDER=
KAFKA_PASSWORD_INVENTORY=
KAFKA_PASSWORD_BILLING=
KAFKA_PASSWORD_SHIPPING=
KAFKA_PASSWORD_NOTIFICATION=
KAFKA_PASSWORD_OPS=

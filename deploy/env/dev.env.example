# DEV settings. scripts/stack.sh copies this file to deploy/env/dev.env on first
# use and replaces every __GENERATE__ with a random value, so no two machines
# share a secret and none is ever committed. Delete dev.env (and the volumes:
# scripts/stack.sh dev down -v) to start again from scratch.

COMMERCE_ENV=dev
APP_BASE_URL=http://localhost:8081
STOREFRONT_PORT=8081
# The ops console (same accounts; administrators only)
OPS_CONSOLE_PORT=8082
# Passkeys work on the console's origin too.
PASSKEY_EXTRA_ORIGINS=http://localhost:8082

# The first account verified with this address becomes an administrator.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# DEV has no second factor on the seeded administrator.
ADMIN_REQUIRES_MFA=false
OPS_REQUIRE_MFA=false

# Mail goes to Mailpit (http://localhost:8025), which has no MX records and takes
# no credentials.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=Commerce <no-reply@commerce.local>
SIGNUP_CHECK_MX=false

# The simulated payment provider (DEV only; billing refuses it anywhere else)
PAYMENT_GATEWAY_URL=http://simulators:8080
PAYMENT_GATEWAY_KEY=__GENERATE__
SIMULATORS_PORT=8090
# The simulated carrier
CARRIER_URL=http://simulators:8080
CARRIER_KEY=__GENERATE__
# The administrator smoke.sh and the testkit sign in as (BOOTSTRAP_ADMIN_EMAIL)
DEV_ADMIN_PASSWORD=__GENERATE__
# shopper@example.com and the simulated shoppers (sim-<n>@example.com)
DEV_SHOPPER_PASSWORD=__GENERATE__
# Simulated shoppers started with the stack (0: start them from the console)
TESTKIT_SHOPPERS=0

# Observability tools, on loopback (Grafana user: admin)
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=__GENERATE__
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# Identity
JWT_SECRET=__GENERATE_B64__
DATA_ENCRYPTION_KEY=__GENERATE_B64__

# Shared by the edges and the services (X-Edge-Token)
EDGE_SHARED_SECRET=__GENERATE__

# MySQL: the administrator, and an owner and an app login per database
DB_ADMIN_PASSWORD=__GENERATE__
DB_EXPORTER_PASSWORD=__GENERATE__
IDENTITY_DB_OWNER_PASSWORD=__GENERATE__
IDENTITY_DB_PASSWORD=__GENERATE__
CATALOG_DB_OWNER_PASSWORD=__GENERATE__
CATALOG_DB_PASSWORD=__GENERATE__
ORDERS_DB_OWNER_PASSWORD=__GENERATE__
ORDERS_DB_PASSWORD=__GENERATE__
INVENTORY_DB_OWNER_PASSWORD=__GENERATE__
INVENTORY_DB_PASSWORD=__GENERATE__
BILLING_DB_OWNER_PASSWORD=__GENERATE__
BILLING_DB_PASSWORD=__GENERATE__
SHIPPING_DB_OWNER_PASSWORD=__GENERATE__
SHIPPING_DB_PASSWORD=__GENERATE__
NOTIFICATION_DB_OWNER_PASSWORD=__GENERATE__
NOTIFICATION_DB_PASSWORD=__GENERATE__
OPS_DB_OWNER_PASSWORD=__GENERATE__
OPS_DB_PASSWORD=__GENERATE__

# Kafka: one credential per principal
KAFKA_PASSWORD_BROKER=__GENERATE__
KAFKA_PASSWORD_INIT=__GENERATE__
KAFKA_PASSWORD_CATALOG=__GENERATE__
KAFKA_PASSWORD_ORDER=__GENERATE__
KAFKA_PASSWORD_INVENTORY=__GENERATE__
KAFKA_PASSWORD_BILLING=__GENERATE__
KAFKA_PASSWORD_SHIPPING=__GENERATE__
KAFKA_PASSWORD_NOTIFICATION=__GENERATE__
KAFKA_PASSWORD_OPS=__GENERATE__
# DEV-only principals of the chaos lab
KAFKA_PASSWORD_TESTKIT=__GENERATE__
KAFKA_PASSWORD_TESTKIT_CHAOS=__GENERATE__
KAFKA_PASSWORD_INTRUDER=__GENERATE__
